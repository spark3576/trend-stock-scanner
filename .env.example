# --- KRX Open API (1순위, 권장) ---
# 발급: https://openapi.krx.co.kr/ (회원가입 후 MyPage에서 인증키 신청, 승인 ~1영업일)
KRX_AUTH_KEY=

# --- KRX 사이트 로그인 (옵션, pykrx fallback용) ---
# KRX Data Marketplace 가입 시 사용하는 ID/PW와 동일.
# 비워두면 KRX OpenAPI만 사용 (정상 동작). 입력하면 pykrx fallback 자동 활성화.
KRX_ID=
KRX_PW=

# --- 네이버 데이터랩 Open API ---
# 발급: https://developers.naver.com/apps/#/register (Application 등록 → "데이터랩(검색어트렌드)" 선택)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- Reddit (PRAW) ---
# 발급: https://www.reddit.com/prefs/apps → Create App → script 선택
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=trend-stock-scanner/0.1 by your_username

# --- 옵션: 디버그 모드 (true 시 각 단계 산출물을 logs/에 dump) ---
SCANNER_DEBUG=false
